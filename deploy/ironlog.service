[Unit]
Description=IronLog lifting dashboard
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ironlog
ExecStart=/usr/bin/node /home/pi/ironlog/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=8787

[Install]
WantedBy=multi-user.target
